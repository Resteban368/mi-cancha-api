// Modelo de datos de Mi Cancha.
// Los enums reflejan las entidades de la app Flutter (mi_cancha/lib/**/domain/entities).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Diagrama ER en docs/database (ERD.md + erd.html); se actualiza en cada generate.
generator erd {
  provider = "node prisma/erd/generator.ts"
  output   = "../docs/database"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN_NEGOCIO
  JUGADOR
}

enum Sport {
  FUTBOL
  PADEL
  BALONCESTO
  VOLEIBOL
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// Posiciones fijas de las fotos de una cancha (hasta 5). Solo MAIN es obligatoria; al crear la cancha
/// se piden MAIN y una segunda opcional (SURFACE, LIGHTING o una extra).
enum CourtPhotoSlot {
  MAIN
  SURFACE
  LIGHTING
  EXTRA_1
  EXTRA_2
}

/// Quién creó la reserva: el negocio (o el super admin) o el jugador desde la web.
enum ReservationSource {
  BUSINESS
  WEB
}

enum ReservationStatus {
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum PaymentConcept {
  ANTICIPO
  SALDO
  TOTAL
  /// Pago de una venta suelta (sin reserva).
  VENTA
}

/// Categoría de un producto: define su ícono en la app.
enum ProductCategory {
  AGUA
  BEBIDA
  HIDRATANTE
  CERVEZA
  SNACK
  COMIDA
  /// Alquiler de petos, balones, raquetas…
  ALQUILER
  OTRO
}

enum SaleStatus {
  ACTIVE
  /// Anulada por el negocio (no se borra: queda para control).
  VOIDED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  /// Devuelto al cliente al cancelar la reserva (ver Refund).
  REFUNDED
}

/// Cualquier persona que inicia sesión: super admin, administrador de negocio o jugador (según role).
/// Los negocios entran con email y contraseña; los jugadores con Google o Apple.
model User {
  id                 String    @id @default(uuid())
  email              String?   @unique
  passwordHash       String?
  /// La cuenta la creó un negocio al registrar al cliente y su clave inicial es la cédula: debe
  /// cambiarla (y aceptar la política de datos) en su primer ingreso.
  mustChangePassword Boolean   @default(false)
  displayName        String
  phone              String?
  role               UserRole
  verified           Boolean   @default(false)
  /// Identificador de la cuenta de Google del jugador.
  googleSub          String?   @unique
  /// Identificador de la cuenta de Apple del jugador.
  appleSub           String?   @unique
  /// Cédula del jugador (sin puntos); con el celular sirve para iniciar sesión.
  documentId         String?   @unique
  birthDate          DateTime? @db.Date
  favoriteSport      Sport?
  /// Aceptación de la política de tratamiento de datos (Ley 1581) y su versión.
  dataConsentAt      DateTime?
  dataConsentVersion String?
  /// Previsto para verificar correo y celular con un código (aún no se usa).
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  /// Cuándo el super admin bloqueó la cuenta; null = activa. Una cuenta bloqueada no puede
  /// iniciar sesión ni usar la API (sus tokens dejan de valer).
  bannedAt           DateTime?
  /// Motivo que escribió el super admin al bloquearla.
  bannedReason       String?
  /// Super admin que la bloqueó (sin llave foránea: el dato sobrevive si se borra esa cuenta).
  bannedById         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  business              Business?
  pushSubscriptions     PushSubscription[]
  notifications         Notification[]
  customers             Customer[]
  reservations          Reservation[]
  cancelledReservations Reservation[]      @relation("ReservationCancelledBy")
  refunds               Refund[]
  slotHolds             SlotHold[]

  /// El celular no se repite entre jugadores (sí puede coincidir con el de un negocio).
  @@unique([role, phone])
}

/// La sede deportiva de un cliente. Cada administrador de negocio tiene exactamente una.
model Business {
  id                   String    @id @default(uuid())
  ownerId              String    @unique
  owner                User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                 String
  address              String
  neighborhood         String
  description          String?
  /// Punto de llegada (WGS84). Ambos nulos si aún no se fijó en el mapa.
  latitude             Float?
  longitude            Float?
  /// Identificador del link público de reservas: /reservar/<slug>. Lo genera un
  /// trigger de la base a partir del nombre al crear el negocio (nunca queda nulo).
  slug                 String?   @unique
  /// Si el link público acepta reservas de jugadores.
  onlineBookingEnabled Boolean   @default(true)
  /// Ciudad (municipio de Colombia); de ella sale el departamento. Obligatoria al crear el negocio
  /// (los anteriores a este campo quedan en null hasta que la completen).
  cityId               String?
  city                 City?     @relation(fields: [cityId], references: [id], onDelete: SetNull)
  amenities            Amenity[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  courts            Court[]
  customers         Customer[]
  reservations      Reservation[]
  payments          Payment[]
  refunds           Refund[]
  subscription      Subscription?
  profileImages     BusinessProfileImage[]
  slotHolds         SlotHold[]
  reservationGroups ReservationGroup[]
  products          Product[]
  sales             Sale[]
  cashSessions      CashSession[]

  @@index([cityId])
}

/// Departamento de Colombia (DIVIPOLA del DANE; 32 más Bogotá D.C.). Catálogo fijo cargado por migración.
model Department {
  id     String @id @default(uuid())
  /// Código DANE de 2 dígitos, p. ej. 05 (Antioquia).
  code   String @unique
  name   String
  cities City[]
}

/// Municipio de Colombia (DIVIPOLA del DANE). Catálogo fijo cargado por migración.
model City {
  id           String     @id @default(uuid())
  /// Código DANE de 5 dígitos, p. ej. 05001 (Medellín).
  code         String     @unique
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  businesses   Business[]

  @@index([departmentId, name])
}

/// Fotos del negocio (hasta 5). La de menor position es la portada que sale en el directorio;
/// el archivo vive en Koofr.
model BusinessProfileImage {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Ruta del archivo dentro del almacenamiento, p. ej. mi-cancha/business-profile/<negocio>/<id>.jpg
  storagePath String
  contentType String
  sizeBytes   Int
  /// Orden dentro del negocio, desde 0; la 0 es la portada.
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId, position])
}

/// Cancha que el negocio alquila por turnos. Solo recibe reservas si está activa (isActive) y
/// completa (tiene la foto MAIN). El límite del plan cuenta las activas.
model Court {
  id               String        @id @default(uuid())
  businessId       String
  business         Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name             String
  sport            Sport
  /// true = cubierta o con techo; false = al aire libre.
  isCovered        Boolean       @default(false)
  /// Código ISO 4217 de la moneda de los precios (COP, USD…).
  currency         String        @default("COP")
  /// Precio por hora cuando ninguna tarifa (CourtRate) cubre la franja.
  basePricePerHour Decimal       @db.Decimal(12, 2)
  /// Duración de cada turno en minutos: 30, 60, 90 o 120.
  slotDuration     Int           @default(60)
  /// Superficie o tipo de grama (catálogo); null si no se indicó.
  surfaceId        String?
  surface          CourtSurface? @relation(fields: [surfaceId], references: [id])
  /// Medidas en metros. Van las dos o ninguna.
  lengthMeters     Decimal?      @db.Decimal(5, 2)
  widthMeters      Decimal?      @db.Decimal(5, 2)
  /// Formato: jugadores por equipo (5 en fútbol 5, 2 en pádel); null si no se indicó.
  playersPerSide   Int?
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  schedules    CourtSchedule[]
  rates        CourtRate[]
  photos       CourtPhoto[]
  reservations Reservation[]
  slotHolds    SlotHold[]

  @@unique([businessId, name])
  @@index([surfaceId])
}

/// Turnos que un jugador apartó en la web mientras confirma la reserva. Vencen
/// solos (expiresAt). Un jugador tiene un solo apartado por negocio, de 1 a 3
/// canchas (una fila por cancha, todas con la misma franja).
model SlotHold {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  courtId    String
  court      Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  playerId   String
  player     User     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// Inicio del primer turno y fin del último.
  start      DateTime
  end        DateTime
  slots      Int
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, playerId, courtId])
  @@index([courtId, start])
}

/// Horario de una cancha para un día de la semana. Siempre hay 7 por cancha.
/// Si closeTime es menor que openTime, la cancha cierra al día siguiente (p. ej. 18:00 a 02:00).
model CourtSchedule {
  id        String    @id @default(uuid())
  courtId   String
  court     Court     @relation(fields: [courtId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  isOpen    Boolean
  /// Hora local HH:mm; null si está cerrado.
  openTime  String?
  /// Hora local HH:mm; null si está cerrado.
  closeTime String?

  @@unique([courtId, dayOfWeek])
}

/// Tarifa de una franja horaria (p. ej. nocturna). Reemplaza al precio base en esa franja;
/// una reserva que cruza franjas se cobra por fracciones. Las tarifas no se pueden cruzar.
model CourtRate {
  id           String      @id @default(uuid())
  courtId      String
  court        Court       @relation(fields: [courtId], references: [id], onDelete: Cascade)
  name         String
  pricePerHour Decimal     @db.Decimal(12, 2)
  /// Días en los que empieza la franja.
  days         DayOfWeek[]
  /// Hora local HH:mm. Si endTime es menor, la franja termina al día siguiente.
  startTime    String
  endTime      String
  sortOrder    Int         @default(0)

  @@index([courtId])
}

/// Foto de una cancha en una posición fija. El archivo vive en Koofr.
model CourtPhoto {
  id          String         @id @default(uuid())
  courtId     String
  court       Court          @relation(fields: [courtId], references: [id], onDelete: Cascade)
  slot        CourtPhotoSlot
  /// Ruta del archivo en el almacenamiento, p. ej. mi-cancha/courts/<cancha>/<id>.jpg
  storagePath String
  contentType String
  sizeBytes   Int
  createdAt   DateTime       @default(now())

  @@unique([courtId, slot])
}

/// Un turno reservado en una cancha. La crea el negocio desde la app (o un jugador, en el futuro).
model Reservation {
  id                 String            @id @default(uuid())
  businessId         String
  business           Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  courtId            String
  court              Court             @relation(fields: [courtId], references: [id], onDelete: Restrict)
  playerId           String?
  player             User?             @relation(fields: [playerId], references: [id], onDelete: SetNull)
  /// Cliente del negocio; null en reservas anteriores a la tabla de clientes.
  customerId         String?
  customer           Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  start              DateTime
  end                DateTime
  /// Nombre y teléfono del cliente al momento de reservar.
  customerName       String
  customerDetail     String?
  phone              String
  contactNote        String?
  tag                String?
  isRecurring        Boolean           @default(false)
  /// BUSINESS si la creó el negocio o el super admin; WEB si la creó el jugador.
  source             ReservationSource @default(BUSINESS)
  /// Valor según las tarifas, antes del descuento.
  subtotal           Decimal           @db.Decimal(12, 2)
  discount           Decimal           @default(0) @db.Decimal(12, 2)
  /// subtotal - discount, en la moneda de la cancha.
  totalPrice         Decimal           @db.Decimal(12, 2)
  /// Suma de las ventas activas cargadas a la reserva (bebidas, snacks…). El saldo es
  /// totalPrice + consumptionsTotal - pagos aprobados. Se actualiza con cada venta.
  consumptionsTotal  Decimal           @default(0) @db.Decimal(12, 2)
  status             ReservationStatus @default(CONFIRMED)
  /// Reserva de varias canchas a la vez: las del mismo grupo comparten franja,
  /// se pagan y se cancelan juntas. null = reserva de una sola cancha.
  groupId            String?
  group              ReservationGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledById      String?
  cancelledBy        User?             @relation("ReservationCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  payments Payment[]
  refunds  Refund[]
  sales    Sale[]

  @@index([businessId, start])
  @@index([customerId, status])
  @@index([courtId, start, end])
  @@index([groupId])
}

/// Varias canchas (máximo 3) reservadas a la vez en la misma franja. Cada cancha
/// es una Reservation con este grupo; los pagos van en la primera reserva.
model ReservationGroup {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  reservations Reservation[]

  @@index([businessId])
}

/// Dinero recibido por el negocio, normalmente ligado a una reserva. Los pagos por transferencia
/// Cliente de un negocio (quien reserva). Cada negocio tiene su propia lista;
/// teléfono y cédula son únicos dentro del negocio. El nivel de fidelidad no se
/// guarda: se calcula con sus reservas.
model Customer {
  id             String   @id @default(uuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  phone          String
  /// Número de cédula u otro documento de identidad. null solo en clientes que
  /// llegaron por la web y aún no la registran (el negocio siempre la pide).
  documentId     String?
  /// Deporte habitual elegido por el negocio; si es null se usa el más reservado.
  preferredSport Sport?
  /// Notas internas del negocio (no las ve el cliente).
  notes          String?
  /// Cuenta de jugador vinculada (si se registró en la web).
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reservations Reservation[]
  refunds      Refund[]

  @@unique([businessId, phone])
  @@unique([businessId, documentId])
  @@unique([businessId, userId])
  // Búsqueda por fragmentos (ILIKE '%texto%') con trigramas (extensión pg_trgm).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([documentId(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Devolución de un pago aprobado al cancelar su reserva. El pago queda REFUNDED.
model Refund {
  id            String      @id @default(uuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  paymentId     String      @unique
  payment       Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  amount        Decimal     @db.Decimal(12, 2)
  /// Motivo de la cancelación que originó la devolución.
  reason        String
  createdById   String?
  createdBy     User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@index([businessId, createdAt])
}

/// quedan pendientes hasta que el negocio los aprueba o rechaza.
model Payment {
  id                   String         @id @default(uuid())
  businessId           String
  business             Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reservationId        String?
  reservation          Reservation?   @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  customerName         String
  /// Monto en la moneda del negocio, con hasta 2 decimales.
  amount               Decimal        @db.Decimal(12, 2)
  methodId             String
  method               PaymentMethod  @relation(fields: [methodId], references: [id], onDelete: Restrict)
  concept              PaymentConcept
  status               PaymentStatus  @default(PENDING)
  reference            String?
  note                 String?
  rejectionReason      String?
  registeredByBusiness Boolean        @default(false)
  /// Venta suelta que se pagó con este pago (concepto VENTA).
  saleId               String?        @unique
  sale                 Sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  receivedAt           DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  refund Refund?

  @@index([businessId, status, receivedAt])
  @@index([methodId])
}

/// Producto que vende el negocio por unidad (agua, bebida hidratante, alquiler de petos…).
/// No se borra: se desactiva, para no romper las ventas que ya lo usan.
model Product {
  id         String          @id @default(uuid())
  businessId String
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  category   ProductCategory @default(OTRO)
  /// Precio por unidad en la moneda del negocio.
  price      Decimal         @db.Decimal(12, 2)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  saleItems SaleItem[]

  @@unique([businessId, name])
}

/// Venta de productos: cargada a una reserva (consumo del turno, se paga con la reserva) o
/// suelta (sin reserva, se paga en el momento con su propio pago).
model Sale {
  id            String       @id @default(uuid())
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  /// A quién se le vendió (en una venta suelta es opcional).
  customerName  String?
  total         Decimal      @db.Decimal(12, 2)
  note          String?
  status        SaleStatus   @default(ACTIVE)
  voidReason    String?
  voidedAt      DateTime?
  /// Quién la registró (sin llave foránea: el dato sobrevive si se borra la cuenta).
  createdById   String?
  createdAt     DateTime     @default(now())

  items   SaleItem[]
  payment Payment?

  @@index([businessId, createdAt])
  @@index([reservationId])
}

/// Línea de una venta. Guarda nombre y precio del producto al momento de vender.
model SaleItem {
  id          String   @id @default(uuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  unitPrice   Decimal  @db.Decimal(12, 2)
  quantity    Int
  subtotal    Decimal  @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
}

/// Turno de caja: se abre con una base de efectivo y se cierra contando el efectivo real.
/// Solo una abierta por negocio (índice único parcial en la migración).
model CashSession {
  id           String    @id @default(uuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Efectivo con que se abrió la caja.
  openingCash  Decimal   @db.Decimal(12, 2)
  openingNote  String?
  openedAt     DateTime  @default(now())
  /// Quién la abrió y quién la cerró (sin llave foránea: el dato sobrevive si se borra la cuenta).
  openedById   String?
  openedByName String?
  closedAt     DateTime?
  closedById   String?
  closedByName String?
  /// Al cerrar: base + pagos aprobados en efectivo del turno.
  expectedCash Decimal?  @db.Decimal(12, 2)
  /// Efectivo contado al cerrar.
  countedCash  Decimal?  @db.Decimal(12, 2)
  /// countedCash - expectedCash (negativo = faltante).
  difference   Decimal?  @db.Decimal(12, 2)
  closingNote  String?
  /// Pagos aprobados del turno por método al cerrar: [{ code, name, count, amount }].
  summary      Json?

  @@index([businessId, openedAt])
}

/// Catálogo editable desde el panel: servicios que ofrece un negocio.
model Amenity {
  id        String   @id @default(uuid())
  /// Código estable que usan la API y la app (p. ej. PARQUEADERO).
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businesses Business[]
}

/// Catálogo editable desde el panel: superficie o tipo de grama de una cancha.
model CourtSurface {
  id        String   @id @default(uuid())
  /// Código estable que usan la API y la app (p. ej. GRAMA_SINTETICA).
  code      String   @unique
  name      String
  /// Deportes en los que se ofrece; vacío = todos.
  sports    Sport[]  @default([])
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courts Court[]
}

/// Catálogo editable desde el panel: medios con los que se recibe un pago.
model PaymentMethod {
  id                String   @id @default(uuid())
  /// Código estable que usan la API y la app (p. ej. NEQUI).
  code              String   @unique
  name              String
  /// Si al registrar el pago se pide número de referencia o comprobante (opcional).
  requiresReference Boolean  @default(true)
  active            Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  payments Payment[]
}

/// Plan de suscripción de Mi Cancha (Gratis, Básico, Pro): precio mensual y cuántas canchas permite.
model Plan {
  id           String @id @default(uuid())
  name         String @unique
  /// Precio mensual en COP.
  monthlyPrice Int
  courtLimit   Int
  /// Lista de { title, detail }.
  benefits     Json   @default("[]")

  subscriptions Subscription[]
}

/// Plan que tiene contratado un negocio, su estado (activo o suspendido) y la fecha del próximo cobro.
model Subscription {
  id          String    @id @default(uuid())
  businessId  String    @unique
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId      String
  plan        Plan      @relation(fields: [planId], references: [id])
  since       DateTime  @default(now())
  nextPayment DateTime
  isActive    Boolean   @default(true)
  autoBilling Boolean   @default(true)
  /// Fin de la prueba gratuita; null si el plan es de pago. Vencida la fecha, el negocio queda
  /// como sin plan activo (solo consulta) hasta que se le asigne uno.
  trialEndsAt DateTime?
}

/// Códigos de un solo uso (OTP) enviados por SMS para verificar un celular. Se
/// guarda solo su HMAC-SHA256, nunca el código; vencen a los 5 minutos y se
/// invalidan tras 5 intentos fallidos.
model OtpCode {
  id        String    @id @default(uuid())
  /// Celular en formato E.164 (+573001234567).
  phone     String
  codeHash  String    @map("code_hash")
  /// HMAC de la IP que lo pidió: limita solicitudes por IP sin guardarla.
  ipHash    String?   @map("ip_hash")
  expiresAt DateTime  @map("expires_at")
  attempts  Int       @default(0)
  /// Cuándo se usó; un código usado no se acepta otra vez.
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@index([ipHash, createdAt])
  @@map("otp_codes")
}

/// De dónde viene un evento de auditoría: lo que hace el super admin en el panel o un evento de
/// seguridad (ingresos, registros, recuperación de clave, bloqueos).
enum AuditCategory {
  ADMIN
  SECURITY
}

/// Auditoría: quién hizo qué y cuándo. La app solo agrega filas; nunca las edita ni las borra.
/// Sin llave foránea al usuario a propósito: el registro debe sobrevivir si se borra la cuenta.
model AuditLog {
  id         String        @id @default(uuid())
  category   AuditCategory
  /// Código estable del evento, p. ej. client.created o player.login_failed.
  action     String
  /// false en intentos rechazados (ingreso fallido, límite de códigos).
  success    Boolean       @default(true)
  /// Cuenta que lo hizo; null si no había sesión (p. ej. un ingreso fallido).
  actorId    String?
  actorRole  UserRole?
  /// Nombre, correo o celular de quien lo hizo, como se veía en ese momento.
  actorLabel String?
  /// Sobre qué actuó: tipo (Business, User, Plan…) e id.
  entityType String?
  entityId   String?
  /// Detalle del evento (ruta, cambios, motivo). Nunca contraseñas, códigos ni tokens.
  metadata   Json?
  /// HMAC de la IP (la misma de los códigos SMS); la IP real no se guarda.
  ipHash     String?
  createdAt  DateTime      @default(now())

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

/// Navegador del usuario suscrito a notificaciones push web (Web Push / VAPID).
model PushSubscription {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// URL del servicio push del navegador; única: si el navegador cambia de cuenta, pasa a la nueva.
  endpoint   String   @unique
  /// Claves de cifrado de la suscripción (PushSubscription.toJSON().keys).
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

enum NotificationType {
  NEW_RESERVATION
  ADMIN_BROADCAST
}

/// Aviso que el super admin envió a los negocios: el historial del panel.
model NotificationBroadcast {
  id          String             @id @default(uuid())
  /// Imagen opcional del aviso (se guarda en el almacenamiento de imágenes).
  imageId     String?
  image       NotificationImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  /// Super admin que lo envió (sin llave foránea: el dato sobrevive si se borra la cuenta).
  sentById    String
  /// Nombre de quien lo envió al momento del envío.
  sentByLabel String?
  title       String
  body        String
  url         String?
  /// ALL = todos los negocios; SELECTED = solo los elegidos.
  scope       String
  /// Negocios a los que iba dirigido.
  targeted    Int
  /// De ellos, cuántos tenían avisos activados en algún navegador.
  reachable   Int
  /// Navegadores que lo aceptaron.
  delivered   Int
  createdAt   DateTime           @default(now())

  notifications Notification[]

  @@index([createdAt])
}

/// Notificación de un usuario (su bandeja): existe aunque no tenga el push activado.
model Notification {
  id          String                 @id @default(uuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  body        String
  /// Ruta de la app que se abre al tocarla.
  url         String?
  /// Datos para la app (p. ej. reservationId).
  data        Json?
  broadcastId String?
  broadcast   NotificationBroadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)
  imageId     String?
  image       NotificationImage?     @relation(fields: [imageId], references: [id], onDelete: SetNull)
  /// null = sin leer.
  readAt      DateTime?
  createdAt   DateTime               @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@index([broadcastId])
  @@index([imageId])
}

/// Imagen que acompaña a un aviso. El archivo vive en el almacenamiento (Koofr); aquí solo su ruta.
model NotificationImage {
  id          String   @id @default(uuid())
  storagePath String
  contentType String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  broadcasts    NotificationBroadcast[]
  notifications Notification[]
}
