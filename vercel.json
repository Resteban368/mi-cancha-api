{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:admin && npm run build:web && npm run build",
  "regions": [
    "iad1"
  ],
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/public/admin/index.html"
    },
    {
      "source": "/reservar/:path*",
      "destination": "/public/reservar/index.html"
    }
  ]
}
