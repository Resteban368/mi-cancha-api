# Servidor
PORT=3000
NODE_ENV=development
# Zona horaria del negocio (Colombia, sin horario de verano)
APP_UTC_OFFSET=-05:00

# Base de datos (docker compose up -d)
DATABASE_URL="postgresql://mi_cancha:mi_cancha@localhost:5433/mi_cancha?schema=public"

# JWT
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Login social de jugadores (client IDs separados por coma)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Imágenes en Koofr (WebDAV). Usa una contraseña de aplicación, no la de la cuenta.
KOOFR_EMAIL=
KOOFR_APP_PASSWORD=
# Carpeta raíz dentro de Koofr (las fotos van en <raíz>/business-profile/<negocio>/)
STORAGE_ROOT=mi-cancha
# Origen público para las URLs de imágenes (en Vercel se usa el dominio de producción)
PUBLIC_API_URL=http://localhost:3000

# Seed: super admin inicial (solo desarrollo)
SEED_SUPER_ADMIN_EMAIL=superadmin@micancha.co
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin2026!

# Códigos OTP por SMS (Twilio Messages API). Sin estas variables, fuera de
# producción no se envían SMS y el código es 123456.
# Consola de Twilio → Account Info (Account SID y Auth Token) y Phone Numbers.
TWILIO_ACCOUNT_SID=
# Credenciales: una API Key (recomendado, Account → API keys & tokens)…
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# …o el Auth Token de la cuenta.
TWILIO_AUTH_TOKEN=
# Número de Twilio en formato E.164 (+1…) o un Messaging Service SID (MG…)
TWILIO_FROM_NUMBER=
# Notificaciones push web (Web Push / VAPID). Genera el par con:
#   npx web-push generate-vapid-keys
# Sin ellas, fuera de producción solo se registra en el log.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tudominio.com
# Secreto para el HMAC de los códigos (mín. 32 caracteres). Si falta se deriva de JWT_SECRET.
OTP_SECRET=
